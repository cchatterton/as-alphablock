        {
            "key": "field_alphablock_post_query_help",
            "label": "Post query guidance",
            "name": "",
            "type": "message",
            "wrapper": {
                "width": "100",
                "class": "",
                "id": ""
            },
            "message": "<p><strong>Post type:</strong> leave unselected (Any post type) to query across post types, or select a type to restrict the results. Only published posts are rendered.</p>\n<ul>\n<li><strong>None:</strong> use the post type, ordering and total above, without additional filters.</li>\n<li><strong>All:</strong> match every filter on the Query Logic tab.</li>\n<li><strong>Any:</strong> match at least one filter on the Query Logic tab.</li>\n<li><strong>Build:</strong> work through filters from top to bottom, adding unique posts until the total posts quota is reached or the filters are exhausted. Each filter uses the selected ordering; results remain grouped by filter priority. A total of -1 processes all filters without a quota.</li>\n<li><strong>Family:</strong> select relatives of a reference post. Configure the relationships on the Family tab.</li>\n</ul>\n<p>All, Any and Build use the base query when no filters are configured. In Build, manual inclusions count towards the quota and exclusions take precedence. In other modes, manual inclusions are appended after the query limit, preserving existing behaviour.</p>",
            "new_lines": "",
            "esc_html": 0
        },
